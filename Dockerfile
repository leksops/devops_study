# 1. Берем за основу самый популярный и легкий образ веб-сервера Nginx
FROM nginx:alpine

# 2. Копируем наш сгенерированный файл index.html в секретную папку Nginx,
# откуда он автоматически начинает показывать сайты всему миру
COPY index.html /usr/share/nginx/html/index.html

# 3. Указываем, что контейнер будет слушать стандартный веб-порт 80
EXPOSE 80


