# 1. Берем за основу официальный чистый образ Python из интернета
FROM python:3.10-slim

# 2. Создаем внутри контейнера рабочую папку /app
WORKDIR /app

# 3. Копируем наш файл system_check.py с вашего компьютера внутрь контейнера
COPY system_check.py .

# 4. Говорим, какую команду выполнить автоматически при старте контейнера
CMD ["python", "system_check.py"]

